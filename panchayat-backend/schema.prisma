generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model adminnotification {
  id         Int      @id @default(autoincrement())
  title      String
  message    String   @db.Text
  type       String
  is_read    Boolean  @default(false)
  action_url String?
  created_at DateTime @default(now())
  sender_id  Int?
  user       user?    @relation(fields: [sender_id], references: [id], map: "AdminNotification_sender_id_fkey")

  @@index([sender_id], map: "AdminNotification_sender_id_fkey")
}

model agrischeme {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  benefit     String
  link        String?
}

model attendance {
  id          Int      @id @default(autoincrement())
  employee_id Int
  date        DateTime
  status      String
  check_in    String?
  check_out   String?
  marked_at   DateTime @default(now())
  employee    employee @relation(fields: [employee_id], references: [id], onDelete: Cascade, map: "Attendance_employee_id_fkey")

  @@index([employee_id], map: "Attendance_employee_id_fkey")
}

model campregistration {
  id            Int        @id @default(autoincrement())
  camp_id       Int
  citizen_id    Int
  registered_at DateTime   @default(now())
  healthcamp    healthcamp @relation(fields: [camp_id], references: [id], onDelete: Cascade, map: "CampRegistration_camp_id_fkey")
  user          user       @relation(fields: [citizen_id], references: [id], map: "CampRegistration_citizen_id_fkey")

  @@unique([camp_id, citizen_id], map: "CampRegistration_camp_id_citizen_id_key")
  @@index([citizen_id], map: "CampRegistration_citizen_id_fkey")
}

model certificate {
  id                                     Int                @id @default(autoincrement())
  application_number                     String             @unique(map: "Certificate_application_number_key")
  citizen_id                             Int
  certificate_type                       String
  data                                   String             @db.LongText
  purpose                                String             @db.Text
  status                                 certificate_status @default(pending)
  submitted_at                           DateTime           @default(now())
  processed_at                           DateTime?
  processed_by_id                        Int?
  remarks                                String?            @db.Text
  certificate_url                        String?
  user_certificate_citizen_idTouser      user               @relation("certificate_citizen_idTouser", fields: [citizen_id], references: [id], map: "Certificate_citizen_id_fkey")
  user_certificate_processed_by_idTouser user?              @relation("certificate_processed_by_idTouser", fields: [processed_by_id], references: [id], map: "Certificate_processed_by_id_fkey")

  @@index([citizen_id], map: "Certificate_citizen_id_fkey")
  @@index([processed_by_id], map: "Certificate_processed_by_id_fkey")
}

model citizennotification {
  id         Int      @id @default(autoincrement())
  citizen_id Int
  title      String
  message    String   @db.Text
  type       String
  is_read    Boolean  @default(false)
  action_url String?
  created_at DateTime @default(now())
  user       user     @relation(fields: [citizen_id], references: [id], map: "CitizenNotification_citizen_id_fkey")

  @@index([citizen_id], map: "CitizenNotification_citizen_id_fkey")
}

model citizenprofile {
  id                 Int                    @id @default(autoincrement())
  user_id            Int                    @unique(map: "CitizenProfile_user_id_key")
  aadhaar_number     String                 @unique(map: "CitizenProfile_aadhaar_number_key")
  date_of_birth      DateTime?
  gender             citizenprofile_gender?
  address            String?                @db.Text
  village            String?
  pincode            String?
  avatar_url         String?
  father_name        String?
  ration_card_number String?
  ration_card_type   String?                @default("APL")
  user               user                   @relation(fields: [user_id], references: [id], map: "CitizenProfile_user_id_fkey")
}

model complaint {
  id                                  Int              @id @default(autoincrement())
  complaint_number                    String           @unique(map: "Complaint_complaint_number_key")
  citizen_id                          Int
  complaint_type                      String
  subject                             String
  description                         String           @db.Text
  location                            String?
  status                              complaint_status @default(open)
  priority                            String           @default("medium")
  assigned_to_id                      Int?
  submitted_at                        DateTime         @default(now())
  resolved_at                         DateTime?
  image_url                           String?
  admin_reply                         String?          @db.Text
  citizen_confirmed                   Boolean          @default(false)
  resolution_image_url                String?
  user_complaint_assigned_to_idTouser user?            @relation("complaint_assigned_to_idTouser", fields: [assigned_to_id], references: [id], map: "Complaint_assigned_to_id_fkey")
  user_complaint_citizen_idTouser     user             @relation("complaint_citizen_idTouser", fields: [citizen_id], references: [id], map: "Complaint_citizen_id_fkey")

  @@index([assigned_to_id], map: "Complaint_assigned_to_id_fkey")
  @@index([citizen_id], map: "Complaint_citizen_id_fkey")
}

model developmentproject {
  id                  Int      @id @default(autoincrement())
  name                String
  category            String
  budget              Float
  start_date          DateTime
  expected_completion DateTime
  progress            Int      @default(0)
  before_image        String?
  after_image         String?
  status              String   @default("planning")
  created_at          DateTime @default(now())
  updated_by          String?
}

model emergencyalert {
  id         Int      @id @default(autoincrement())
  title      String
  message    String   @db.Text
  alert_type String
  active     Boolean  @default(true)
  created_at DateTime @default(now())
}

model employee {
  id           Int            @id @default(autoincrement())
  name         String
  designation  String
  user_id      Int?           @unique(map: "Employee_user_id_key")
  created_at   DateTime       @default(now())
  attendance   attendance[]
  user         user?          @relation(fields: [user_id], references: [id], map: "Employee_user_id_fkey")
  leaverequest leaverequest[]
}

model family {
  id                                 Int      @id @default(autoincrement())
  head_id                            Int      @unique(map: "Family_head_id_key")
  ward_number                        String
  address                            String   @db.Text
  created_at                         DateTime @default(now())
  user_family_head_idTouser          user     @relation("family_head_idTouser", fields: [head_id], references: [id], map: "Family_head_id_fkey")
  user_user_family_member_idTofamily user[]   @relation("user_family_member_idTofamily")
}

model feedback {
  id           Int      @id @default(autoincrement())
  citizen_id   Int
  service_name String
  rating       Int
  comments     String?  @db.Text
  submitted_at DateTime @default(now())
  user         user     @relation(fields: [citizen_id], references: [id], map: "Feedback_citizen_id_fkey")

  @@index([citizen_id], map: "Feedback_citizen_id_fkey")
}

model gramsabhameeting {
  id               Int               @id @default(autoincrement())
  date_time        DateTime
  agenda           String            @db.Text
  location         String
  status           String            @default("scheduled")
  notice_published Boolean           @default(false)
  minutes_url      String?
  created_at       DateTime          @default(now())
  resolutions      String?           @db.Text
  started_at       DateTime?
  completed_at     DateTime?
  sabhaattendance  sabhaattendance[]
  sabhasuggestion  sabhasuggestion[]
}

model healthcamp {
  id               Int                @id @default(autoincrement())
  camp_name        String
  camp_type        String
  date             DateTime
  location         String
  description      String             @db.Text
  timing           String?
  organizing_team  String?
  target_audience  String?
  required_docs    String?
  campregistration campregistration[]
}

model leaverequest {
  id          Int       @id @default(autoincrement())
  employee_id Int
  start_date  DateTime
  end_date    DateTime
  reason      String    @db.Text
  status      String    @default("pending")
  reviewed_at DateTime?
  employee    employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade, map: "LeaveRequest_employee_id_fkey")

  @@index([employee_id], map: "LeaveRequest_employee_id_fkey")
}

model notice {
  id            Int       @id @default(autoincrement())
  title         String
  content       String    @db.Text
  notice_type   String
  is_published  Boolean   @default(false)
  expiry_date   DateTime?
  created_at    DateTime  @default(now())
  created_by_id Int
  user          user      @relation(fields: [created_by_id], references: [id], map: "Notice_created_by_id_fkey")

  @@index([created_by_id], map: "Notice_created_by_id_fkey")
}

model rationreceipt {
  id          Int      @id @default(autoincrement())
  citizen_id  Int
  month_year  String
  received_at DateTime @default(now())
  user        user     @relation(fields: [citizen_id], references: [id], map: "RationReceipt_citizen_id_fkey")

  @@index([citizen_id], map: "RationReceipt_citizen_id_fkey")
}

model rationschedule {
  id                   Int      @id @default(autoincrement())
  distribution_date    DateTime
  timing_description   String
  items_available      String
  shop_name            String?
  card_type            String?
  ward_area            String?
  special_instructions String?  @db.Text
  status               String   @default("active")
  contact_number       String?
}

model registrationrequest {
  id               Int                        @id @default(autoincrement())
  full_name        String
  date_of_birth    DateTime
  gender           registrationrequest_gender
  aadhaar_number   String                     @unique(map: "RegistrationRequest_aadhaar_number_key")
  email            String                     @unique(map: "RegistrationRequest_email_key")
  mobile           String
  address          String                     @db.Text
  village          String                     @default("Sarahi")
  pincode          String
  password_hash    String
  status           registrationrequest_status @default(pending)
  submitted_at     DateTime                   @default(now())
  reviewed_at      DateTime?
  reviewed_by_id   Int?
  rejection_reason String?                    @db.Text
  father_name      String?
  user             user?                      @relation(fields: [reviewed_by_id], references: [id], map: "RegistrationRequest_reviewed_by_id_fkey")

  @@index([reviewed_by_id], map: "RegistrationRequest_reviewed_by_id_fkey")
}

model sabhaattendance {
  id               Int              @id @default(autoincrement())
  meeting_id       Int
  citizen_id       Int
  marked_at        DateTime         @default(now())
  user             user             @relation(fields: [citizen_id], references: [id], map: "SabhaAttendance_citizen_id_fkey")
  gramsabhameeting gramsabhameeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade, map: "SabhaAttendance_meeting_id_fkey")

  @@unique([meeting_id, citizen_id], map: "SabhaAttendance_meeting_id_citizen_id_key")
  @@index([citizen_id], map: "SabhaAttendance_citizen_id_fkey")
}

model sabhasuggestion {
  id                   Int                    @id @default(autoincrement())
  meeting_id           Int
  citizen_id           Int
  suggestion_text      String                 @db.Text
  submitted_at         DateTime               @default(now())
  user                 user                   @relation(fields: [citizen_id], references: [id], map: "SabhaSuggestion_citizen_id_fkey")
  gramsabhameeting     gramsabhameeting       @relation(fields: [meeting_id], references: [id], onDelete: Cascade, map: "SabhaSuggestion_meeting_id_fkey")
  sabhasuggestionreply sabhasuggestionreply[]

  @@index([citizen_id], map: "SabhaSuggestion_citizen_id_fkey")
  @@index([meeting_id], map: "SabhaSuggestion_meeting_id_fkey")
}

model sabhasuggestionreply {
  id              Int             @id @default(autoincrement())
  suggestion_id   Int
  citizen_id      Int
  reply_text      String          @db.Text
  created_at      DateTime        @default(now())
  user            user            @relation(fields: [citizen_id], references: [id], map: "SabhaSuggestionReply_citizen_id_fkey")
  sabhasuggestion sabhasuggestion @relation(fields: [suggestion_id], references: [id], onDelete: Cascade, map: "SabhaSuggestionReply_suggestion_id_fkey")

  @@index([citizen_id], map: "SabhaSuggestionReply_citizen_id_fkey")
  @@index([suggestion_id], map: "SabhaSuggestionReply_suggestion_id_fkey")
}

model scheme {
  id                Int                 @id @default(autoincrement())
  scheme_name       String
  description       String              @db.Text
  is_active         Boolean             @default(true)
  created_by_id     Int
  created_at        DateTime            @default(now())
  benefit           String?
  category          String?
  color_theme       String?
  icon              String?
  form_fields       String?             @db.LongText
  user              user                @relation(fields: [created_by_id], references: [id], map: "Scheme_created_by_id_fkey")
  schemeapplication schemeapplication[]

  @@index([created_by_id], map: "Scheme_created_by_id_fkey")
}

model schemeapplication {
  id            Int      @id @default(autoincrement())
  scheme_id     Int
  citizen_id    Int
  status        String   @default("Pending")
  submitted_at  DateTime @default(now())
  form_data     String?  @db.LongText
  admin_remarks String?  @db.Text
  result_file   String?
  user          user     @relation(fields: [citizen_id], references: [id], map: "SchemeApplication_citizen_id_fkey")
  scheme        scheme   @relation(fields: [scheme_id], references: [id], onDelete: Cascade, map: "SchemeApplication_scheme_id_fkey")

  @@index([citizen_id], map: "SchemeApplication_citizen_id_fkey")
  @@index([scheme_id], map: "SchemeApplication_scheme_id_fkey")
}

model seasonaladvisory {
  id               Int     @id @default(autoincrement())
  crop_name        String
  advisory_message String  @db.Text
  month            String
  fertilizer_info  String? @db.Text
}

model suggestionvote {
  id             Int            @id @default(autoincrement())
  suggestion_id  Int
  citizen_id     Int
  user           user           @relation(fields: [citizen_id], references: [id], map: "SuggestionVote_citizen_id_fkey")
  usersuggestion usersuggestion @relation(fields: [suggestion_id], references: [id], onDelete: Cascade, map: "SuggestionVote_suggestion_id_fkey")

  @@unique([suggestion_id, citizen_id], map: "SuggestionVote_suggestion_id_citizen_id_key")
  @@index([citizen_id], map: "SuggestionVote_citizen_id_fkey")
}

model taxrecord {
  id             Int       @id @default(autoincrement())
  citizen_id     Int
  tax_type       String
  amount         Float
  due_date       DateTime
  status         String    @default("unpaid")
  payment_date   DateTime?
  transaction_id String?
  created_at     DateTime  @default(now())
  penalty_rate   Float     @default(0)
  user           user      @relation(fields: [citizen_id], references: [id], map: "TaxRecord_citizen_id_fkey")

  @@index([citizen_id], map: "TaxRecord_citizen_id_fkey")
}

model user {
  id                                                  Int                    @id @default(autoincrement())
  email                                               String                 @unique(map: "User_email_key")
  password_hash                                       String
  role                                                user_role              @default(citizen)
  full_name                                           String
  mobile                                              String?
  is_active                                           Boolean                @default(true)
  created_at                                          DateTime               @default(now())
  updated_at                                          DateTime
  family_member_id                                    Int?
  address                                             String?                @db.Text
  avatar_url                                          String?
  bio                                                 String?                @db.Text
  date_of_birth                                       DateTime?
  adminnotification                                   adminnotification[]
  campregistration                                    campregistration[]
  certificate_certificate_citizen_idTouser            certificate[]          @relation("certificate_citizen_idTouser")
  certificate_certificate_processed_by_idTouser       certificate[]          @relation("certificate_processed_by_idTouser")
  citizennotification                                 citizennotification[]
  citizenprofile                                      citizenprofile?
  complaint_complaint_assigned_to_idTouser            complaint[]            @relation("complaint_assigned_to_idTouser")
  complaint_complaint_citizen_idTouser                complaint[]            @relation("complaint_citizen_idTouser")
  employee                                            employee?
  family_family_head_idTouser                         family?                @relation("family_head_idTouser")
  feedback                                            feedback[]
  notice                                              notice[]
  rationreceipt                                       rationreceipt[]
  registrationrequest                                 registrationrequest[]
  sabhaattendance                                     sabhaattendance[]
  sabhasuggestion                                     sabhasuggestion[]
  sabhasuggestionreply                                sabhasuggestionreply[]
  scheme                                              scheme[]
  schemeapplication                                   schemeapplication[]
  suggestionvote                                      suggestionvote[]
  taxrecord                                           taxrecord[]
  family_user_family_member_idTofamily                family?                @relation("user_family_member_idTofamily", fields: [family_member_id], references: [id], map: "User_family_member_id_fkey")
  usersuggestion_usersuggestion_citizen_idTouser      usersuggestion[]       @relation("usersuggestion_citizen_idTouser")
  usersuggestion_usersuggestion_processed_by_idTouser usersuggestion[]       @relation("usersuggestion_processed_by_idTouser")

  @@index([family_member_id], map: "User_family_member_id_fkey")
}

model usersuggestion {
  id                                        Int              @id @default(autoincrement())
  citizen_id                                Int
  title                                     String
  description                               String           @db.Text
  status                                    String           @default("pending")
  submitted_at                              DateTime         @default(now())
  processed_by_id                           Int?
  suggestionvote                            suggestionvote[]
  user_usersuggestion_citizen_idTouser      user             @relation("usersuggestion_citizen_idTouser", fields: [citizen_id], references: [id], map: "UserSuggestion_citizen_id_fkey")
  user_usersuggestion_processed_by_idTouser user?            @relation("usersuggestion_processed_by_idTouser", fields: [processed_by_id], references: [id], map: "UserSuggestion_processed_by_id_fkey")

  @@index([citizen_id], map: "UserSuggestion_citizen_id_fkey")
  @@index([processed_by_id], map: "UserSuggestion_processed_by_id_fkey")
}

model villageasset {
  id                   Int       @id @default(autoincrement())
  name                 String
  asset_type           String
  location             String
  condition            String
  last_inspection_date DateTime?
  image_url            String?
  created_at           DateTime  @default(now())
}

model watersupplyschedule {
  id         Int      @id @default(autoincrement())
  area       String
  timing     String
  status     String   @default("active")
  notes      String?  @db.Text
  updated_at DateTime
}

model watertank {
  id          Int       @id @default(autoincrement())
  location    String
  capacity    Float
  condition   String
  last_filled DateTime?
}

enum registrationrequest_gender {
  male
  female
  other
}

enum user_role {
  citizen
  clerk
  admin
}

enum citizenprofile_gender {
  male
  female
  other
}

enum certificate_status {
  pending
  approved
  rejected
}

enum complaint_status {
  open
  in_progress
  resolution_proposed
  resolved
  closed
}

enum registrationrequest_status {
  pending
  approved
  rejected
}
