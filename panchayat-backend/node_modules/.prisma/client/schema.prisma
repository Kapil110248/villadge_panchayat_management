// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  citizen
  clerk
  admin
}

enum Gender {
  male
  female
  other
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum CertStatus {
  pending
  approved
  rejected
}

enum ComplaintStatus {
  open
  in_progress
  resolution_proposed
  resolved
  closed
}

// 1. Users Table
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  role          Role     @default(citizen)
  full_name     String
  mobile        String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Extended profile fields (editable by any user)
  avatar_url            String?
  date_of_birth         DateTime?
  address               String?               @db.Text
  bio                   String?               @db.Text
  citizen_notifications CitizenNotification[]

  // Relations
  profile             CitizenProfile?
  certificates        Certificate[]
  complaints          Complaint[]
  assigned_complaints Complaint[]         @relation("AssignedTo")
  schemes_created     Scheme[]
  notices             Notice[]
  sent_notifications  AdminNotification[]

  // Admin actions
  reviewed_requests RegistrationRequest[] @relation("ReviewedBy")
  processed_certs   Certificate[]         @relation("CertProcessedBy")

  // New modules relations
  sabha_suggestions   SabhaSuggestion[]
  sabha_attendance    SabhaAttendance[]
  tax_records         TaxRecord[]
  employee            Employee?
  feedbacks           Feedback[]
  family_head         Family?                @relation("FamilyHead")
  family_member_id    Int?
  family              Family?                @relation("FamilyMembers", fields: [family_member_id], references: [id])
  suggestions         UserSuggestion[]
  votes               SuggestionVote[]
  ration_receipts     RationReceipt[]
  camp_registrations  CampRegistration[]
  scheme_applications SchemeApplication[]
  sabha_replies       SabhaSuggestionReply[]
}

// 2. Registration Requests (For public signups)
model RegistrationRequest {
  id             Int           @id @default(autoincrement())
  full_name      String
  date_of_birth  DateTime
  gender         Gender
  aadhaar_number String        @unique
  email          String        @unique
  mobile         String
  address        String        @db.Text
  village        String        @default("Sarahi")
  pincode        String
  password_hash  String
  status         RequestStatus @default(pending)

  submitted_at     DateTime  @default(now())
  reviewed_at      DateTime?
  reviewed_by_id   Int?
  rejection_reason String?   @db.Text

  reviewer User? @relation("ReviewedBy", fields: [reviewed_by_id], references: [id])
}

// 3. Citizen Profiles (Extended info for users)
model CitizenProfile {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  aadhaar_number String    @unique
  date_of_birth  DateTime?
  gender         Gender?
  address        String?   @db.Text
  village        String?
  pincode        String?
  avatar_url     String?

  user User @relation(fields: [user_id], references: [id])
}

// 4. Certificates
model Certificate {
  id                 Int    @id @default(autoincrement())
  application_number String @unique // e.g., CERT-2026-001
  citizen_id         Int
  certificate_type   String // birth, death, income, residence

  // Flexible JSON field to store type-specific data (child_name, income_amount, etc.)
  data Json

  purpose      String     @db.Text
  status       CertStatus @default(pending)
  submitted_at DateTime   @default(now())

  processed_at    DateTime?
  processed_by_id Int?
  remarks         String?   @db.Text
  certificate_url String? // PDF link

  citizen   User  @relation(fields: [citizen_id], references: [id])
  processor User? @relation("CertProcessedBy", fields: [processed_by_id], references: [id])
}

// 6. Complaints
model Complaint {
  id               Int             @id @default(autoincrement())
  complaint_number String          @unique
  citizen_id       Int
  complaint_type   String // water, road, electricity
  subject          String
  description      String          @db.Text
  location         String?
  image_url        String?
  status           ComplaintStatus @default(open)
  priority         String          @default("medium") // low, medium, high

  admin_reply          String? @db.Text
  resolution_image_url String?
  citizen_confirmed    Boolean @default(false)

  assigned_to_id Int?
  submitted_at   DateTime  @default(now())
  resolved_at    DateTime?

  citizen  User  @relation(fields: [citizen_id], references: [id])
  assignee User? @relation("AssignedTo", fields: [assigned_to_id], references: [id])
}

// 9. Schemes
model Scheme {
  id            Int     @id @default(autoincrement())
  scheme_name   String
  description   String  @db.Text
  is_active     Boolean @default(true)
  created_by_id Int

  category    String?
  benefit     String?
  icon        String?
  color_theme String?
  form_fields Json? // Dynamic form fields defined by admin

  created_at   DateTime            @default(now())
  creator      User                @relation(fields: [created_by_id], references: [id])
  applications SchemeApplication[]
}

model SchemeApplication {
  id            Int      @id @default(autoincrement())
  scheme_id     Int
  citizen_id    Int
  status        String   @default("Pending") // Pending, Ready, Approved, Rejected
  form_data     Json? // Citizen's submitted form data
  admin_remarks String?  @db.Text
  result_file   String? // Certificate / Document uploaded by admin
  submitted_at  DateTime @default(now())

  scheme  Scheme @relation(fields: [scheme_id], references: [id], onDelete: Cascade)
  citizen User   @relation(fields: [citizen_id], references: [id])
}

// 11. Notices
model Notice {
  id           Int       @id @default(autoincrement())
  title        String
  content      String    @db.Text
  notice_type  String // important, update, success
  is_published Boolean   @default(false)
  expiry_date  DateTime?
  created_at   DateTime  @default(now())

  created_by_id Int
  creator       User @relation(fields: [created_by_id], references: [id])
}

// 12. Gram Sabha Meetings
model GramSabhaMeeting {
  id               Int      @id @default(autoincrement())
  date_time        DateTime
  agenda           String   @db.Text
  location         String
  status           String   @default("scheduled") // scheduled, completed, cancelled
  notice_published Boolean  @default(false)
  minutes_url      String? // PDF path for meeting minutes
  resolutions      String?  @db.Text
  created_at       DateTime @default(now())

  suggestions SabhaSuggestion[]
  attendance  SabhaAttendance[]
}

model SabhaSuggestion {
  id              Int      @id @default(autoincrement())
  meeting_id      Int
  citizen_id      Int
  suggestion_text String   @db.Text
  submitted_at    DateTime @default(now())

  meeting GramSabhaMeeting       @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  citizen User                   @relation(fields: [citizen_id], references: [id])
  replies SabhaSuggestionReply[]
}

model SabhaSuggestionReply {
  id            Int      @id @default(autoincrement())
  suggestion_id Int
  citizen_id    Int
  reply_text    String   @db.Text
  created_at    DateTime @default(now())

  suggestion SabhaSuggestion @relation(fields: [suggestion_id], references: [id], onDelete: Cascade)
  citizen    User            @relation(fields: [citizen_id], references: [id])
}

model SabhaAttendance {
  id         Int      @id @default(autoincrement())
  meeting_id Int
  citizen_id Int
  marked_at  DateTime @default(now())

  meeting GramSabhaMeeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  citizen User             @relation(fields: [citizen_id], references: [id])

  @@unique([meeting_id, citizen_id])
}

// 13. Village Development Projects
model DevelopmentProject {
  id                  Int      @id @default(autoincrement())
  name                String
  category            String // Road Construction, Drain Construction, School Repair, Water Pipeline, Street Light Installation, Community Hall
  budget              Float
  start_date          DateTime
  expected_completion DateTime
  progress            Int      @default(0) // 0 to 100
  before_image        String? // Image URL
  after_image         String? // Image URL
  status              String   @default("planning") // planning, active, completed, suspended
  updated_by          String? // Name of user who last updated progress
  created_at          DateTime @default(now())
}

// 14. Water Supply Schedule & Timings
model WaterSupplySchedule {
  id         Int      @id @default(autoincrement())
  area       String
  timing     String // e.g. "06:00 AM - 08:00 AM"
  status     String   @default("active") // active, interrupted
  notes      String?  @db.Text
  updated_at DateTime @updatedAt
}

model WaterTank {
  id          Int       @id @default(autoincrement())
  location    String
  capacity    Float // In Liters
  condition   String // Good, Maintenance Needed, Inoperable
  last_filled DateTime?
}

// 15. Taxes (House Tax & Water Tax)
model TaxRecord {
  id             Int       @id @default(autoincrement())
  citizen_id     Int
  tax_type       String // house, water
  amount         Float
  due_date       DateTime
  status         String    @default("unpaid") // unpaid, paid
  payment_date   DateTime?
  transaction_id String?
  created_at     DateTime  @default(now())

  citizen User @relation(fields: [citizen_id], references: [id])
}

// 16. Village Assets
model VillageAsset {
  id                   Int       @id @default(autoincrement())
  name                 String
  asset_type           String // Panchayat Bhawan, School, Anganwadi, Water Tank, Community Hall, Playground, Other
  location             String
  condition            String // Good, Fair, Poor, Under Construction
  last_inspection_date DateTime?
  image_url            String?
  created_at           DateTime  @default(now())
}

// 17. Employee & Staff Attendance
model Employee {
  id          Int      @id @default(autoincrement())
  name        String
  designation String // clerk, safai_karmachari, other
  user_id     Int?     @unique
  created_at  DateTime @default(now())

  user           User?          @relation(fields: [user_id], references: [id])
  attendance     Attendance[]
  leave_requests LeaveRequest[]
}

model Attendance {
  id          Int      @id @default(autoincrement())
  employee_id Int
  date        DateTime
  status      String // present, absent, leave
  check_in    String? // "HH:MM"
  check_out   String? // "HH:MM"
  marked_at   DateTime @default(now())

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id          Int       @id @default(autoincrement())
  employee_id Int
  start_date  DateTime
  end_date    DateTime
  reason      String    @db.Text
  status      String    @default("pending") // pending, approved, rejected
  reviewed_at DateTime?

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
}

// 18. Citizen Feedback & Quality Ratings
model Feedback {
  id           Int      @id @default(autoincrement())
  citizen_id   Int
  service_name String // Sanitation, Water, Electricity, Road, Administration
  rating       Int // 1 to 5
  comments     String?  @db.Text
  submitted_at DateTime @default(now())

  citizen User @relation(fields: [citizen_id], references: [id])
}

// 19. Village Directory / Family mapping
model Family {
  id          Int      @id @default(autoincrement())
  head_id     Int      @unique
  ward_number String
  address     String   @db.Text
  created_at  DateTime @default(now())

  head    User   @relation("FamilyHead", fields: [head_id], references: [id])
  members User[] @relation("FamilyMembers")
}

// 20. Suggestions Box & Upvoting
model UserSuggestion {
  id           Int      @id @default(autoincrement())
  citizen_id   Int
  title        String
  description  String   @db.Text
  status       String   @default("pending") // pending, consideration, approved, rejected, implemented
  submitted_at DateTime @default(now())

  citizen User             @relation(fields: [citizen_id], references: [id])
  votes   SuggestionVote[]
}

model SuggestionVote {
  id            Int @id @default(autoincrement())
  suggestion_id Int
  citizen_id    Int

  suggestion UserSuggestion @relation(fields: [suggestion_id], references: [id], onDelete: Cascade)
  citizen    User           @relation(fields: [citizen_id], references: [id])

  @@unique([suggestion_id, citizen_id])
}

// 21. Ration Distribution System
model RationSchedule {
  id                   Int      @id @default(autoincrement())
  distribution_date    DateTime
  timing_description   String // e.g. "09:00 AM - 05:00 PM"
  items_available      String // e.g. "Wheat, Rice, Sugar, Kerosene"
  shop_name            String? // Kotedar/Dealer name
  card_type            String? // BPL, AAY, APL, All
  ward_area            String? // e.g. Ward 1-5, Whole Village
  special_instructions String?  @db.Text
  status               String   @default("active") // active, cancelled
}

model RationReceipt {
  id          Int      @id @default(autoincrement())
  citizen_id  Int
  month_year  String // e.g. "06-2026"
  received_at DateTime @default(now())

  citizen User @relation(fields: [citizen_id], references: [id])
}

// 22. Agriculture Advisory & Crop Info
model AgriScheme {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  benefit     String
  link        String?
}

model SeasonalAdvisory {
  id               Int     @id @default(autoincrement())
  crop_name        String
  advisory_message String  @db.Text
  month            String // e.g. "June"
  fertilizer_info  String? @db.Text
}

// 23. Health Camps
model HealthCamp {
  id              Int      @id @default(autoincrement())
  camp_name       String
  camp_type       String // Vaccination, Medical, Awareness
  date            DateTime
  location        String
  description     String   @db.Text
  timing          String? // e.g. "09:00 AM - 02:00 PM"
  organizing_team String? // e.g. "Dr. Sharma - City Hospital"
  target_audience String? // e.g. "Children under 5", "All"
  required_docs   String? // e.g. "Aadhaar Card, Old Reports"

  registrations CampRegistration[]
}

model CampRegistration {
  id            Int      @id @default(autoincrement())
  camp_id       Int
  citizen_id    Int
  registered_at DateTime @default(now())

  camp    HealthCamp @relation(fields: [camp_id], references: [id], onDelete: Cascade)
  citizen User       @relation(fields: [citizen_id], references: [id])

  @@unique([camp_id, citizen_id])
}

// 24. Emergency Alerts & Notices
model EmergencyAlert {
  id         Int      @id @default(autoincrement())
  title      String
  message    String   @db.Text
  alert_type String // flood, heavy_rain, disease, power_cut, other
  active     Boolean  @default(true)
  created_at DateTime @default(now())
}

// 25. Global Admin Notifications
model AdminNotification {
  id         Int      @id @default(autoincrement())
  title      String
  message    String   @db.Text
  type       String // complaint, certificate, user_action, etc.
  is_read    Boolean  @default(false)
  action_url String? // Optional link to redirect the admin when clicked
  created_at DateTime @default(now())

  sender_id Int?
  sender    User? @relation(fields: [sender_id], references: [id])
}

// 26. Citizen Notifications
model CitizenNotification {
  id         Int      @id @default(autoincrement())
  citizen_id Int
  title      String
  message    String   @db.Text
  type       String // complaint_update, message, etc.
  is_read    Boolean  @default(false)
  action_url String?
  created_at DateTime @default(now())

  citizen User @relation(fields: [citizen_id], references: [id])
}
